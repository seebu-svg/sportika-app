<?xml version="1.0" encoding="utf-8"?>
<!--
  Sportika keeps an authentication session and personal profile details on the
  device. Neither may leave it inside a cloud backup: a restored backup of a
  signed-in account is a signed-in account on someone else's phone.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
