# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Local scratch
.tmp/
.refactor_backup/

# Scratch artifacts that must never enter the tracked tree: IDE knowledge
# cache, stray Android build output (the real build dir is the ignored /build/),
# and test-run failure lists dropped at the repo root.
.qoder/
android/build/
*.log.fails

# Supabase CLI session state (auth tokens); the backend tree itself is tracked.
supabase/.temp/
